---
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Contact from '../../components/Contact.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map(project=>({params:{slug:project.slug},props:{project}})); }
const { project: p } = Astro.props;
const next = projects[(projects.findIndex(x=>x.slug===p.slug)+1)%projects.length];
---
<Base title={`${p.name} — ${p.category.toLowerCase()} Case Study | Rahul Negi`} description={p.intro} project={{name:p.name,description:p.intro}}>
<div class="container"><section class="case-hero"><a class="text-link back-link" href="/projects/">← All projects</a><p class="eyebrow accent">{p.category} / INDEPENDENT PROJECT</p><h1>{p.name}<span class="title-dot">.</span></h1><p class="case-lead">{p.summary}</p><p class="case-intro">{p.intro}</p><div class="case-actions"><a class="button primary" href={p.repo}>{p.slug==='slotly' ? 'Public project page' : 'View repository'} <span aria-hidden="true">↗</span></a>{p.demo && <a class="button outline" href={p.demo}>API health check <span aria-hidden="true">↗</span></a>}</div><ul class="tags">{p.stack.map(s=><li>{s}</li>)}</ul></section>
<div class="case-cover"><ProjectVisual type={p.visual} large/><div class="cover-caption"><span class="eyebrow">SYSTEM SKETCH</span><p>Illustrative architecture, not a live product interface.</p></div></div>
<div class="case-layout"><aside class="case-nav" aria-label="Case study contents"><span class="eyebrow muted">INSIDE THE BUILD</span><a href="#problem">01 / The problem</a><a href="#architecture">02 / Architecture</a><a href="#decisions">03 / Decisions</a><a href="#evidence">04 / Evidence</a><a href="#sample">05 / API sample</a><a href="#boundaries">06 / Boundaries</a></aside><div class="case-content">
<section id="problem"><p class="eyebrow accent">01 / THE PROBLEM</p><h2>Start with what can go wrong.</h2><p>{p.problem}</p><p>{p.approach}</p></section>
<section id="architecture"><p class="eyebrow accent">02 / ARCHITECTURE</p><h2>The shape of the system.</h2><ol class="architecture-flow" aria-label={`${p.name} architecture flow`}>{p.nodes.map((node,index)=><li><span class="mono muted">0{index+1}</span><strong>{node}</strong>{index < p.nodes.length-1 && <span class="flow-arrow" aria-hidden="true">↓</span>}</li>)}</ol>{p.slug==='flowguard' && <p class="small muted">Prometheus collects pipeline metrics; Grafana exposes queue depth, breaker state, and outcome counts.</p>}</section>
<section id="decisions"><p class="eyebrow accent">03 / ENGINEERING DECISIONS</p><h2>The choices behind the code.</h2><div class="decision-list">{p.decisions.map((d,index)=><article><span class="mono accent">0{index+1}</span><div><h3>{d.title}</h3><p>{d.text}</p></div></article>)}</div></section>
<section id="evidence"><p class="eyebrow accent">04 / EVIDENCE & VALIDATION</p><h2>{p.slug==='flowguard' ? 'Measured, with context.' : 'Make the behavior inspectable.'}</h2><ul class="evidence-list">{p.evidence.map(e=><li>{e}</li>)}</ul>
{p.slug==='flowguard' && <><div class="benchmark-grid"><div><strong>93.8<span>%</span></strong><p>lower peak outstanding work</p><small>517 → 32 · local backpressure experiment</small></div><div><strong>99.5<span>%</span></strong><p>fewer failed downstream calls</p><small>1,200 → 6 · simulated dependency outage</small></div></div><p class="small muted">Matched configurations within each scenario, except the explicit feature switches. Zero dropped k6 iterations and zero HTTP errors in all four runs. The disabled baseline retains a hard queue cap and fallback DLQ. Lower failed-call volume is not a claim of higher success rate.</p><figure class="evidence-image"><a href="/evidence/backpressure-enabled.webp"><img src="/evidence/backpressure-enabled.webp" alt="Grafana capture from the local Flowguard backpressure-enabled run, showing pipeline monitoring during controlled load." width="1440" height="1200" loading="lazy"/></a><figcaption>Backpressure enabled · captured local experiment, 24 October 2026.</figcaption></figure><figure class="evidence-image"><a href="/evidence/breaker-enabled.webp"><img src="/evidence/breaker-enabled.webp" alt="Grafana capture from the local Flowguard dependency-outage run, showing the circuit breaker open." width="1440" height="1200" loading="lazy"/></a><figcaption>Circuit breaker open during the simulated outage.</figcaption></figure><div class="evidence-downloads"><a class="text-link" href="/evidence/results.json">Raw experiment results ↓</a><a class="text-link" href="/evidence/breaker-transitions.txt">Breaker transition log ↓</a></div></>}
</section>
<section id="sample"><p class="eyebrow accent">05 / A CLOSER LOOK</p><h2>{p.slug==='fastpay' ? 'One intent. One payment.' : p.slug==='slotly' ? 'Book without trusting the client.' : 'Follow the accounting.'}</h2><div class="code-block"><div class="code-heading"><span>REQUEST</span><span>HTTP</span></div><pre><code>{p.request}</code></pre></div><div class="code-block"><div class="code-heading"><span>{p.slug==='fastpay' ? 'REPRESENTATIVE RESPONSE' : 'PROCESSING INVARIANT'}</span><span>{p.slug==='fastpay' ? 'JSON' : 'FLOW'}</span></div><pre><code>{p.response}</code></pre></div><p class="small muted">{p.sampleNote}</p></section>
<section id="boundaries" class="boundaries"><p class="eyebrow accent">06 / SCOPE & BOUNDARIES</p><h2>What this project doesn’t claim.</h2><p>{p.limitations}</p></section>
</div></div><a class="next-project" href={`/projects/${next.slug}/`}><span><small class="eyebrow muted">NEXT CASE STUDY</small><strong>{next.name}</strong></span><span aria-hidden="true">↗</span></a></div><Contact/>
</Base>
