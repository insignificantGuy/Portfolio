---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import { profile, expertise, experience, services } from '../data/profile';
import { projects } from '../data/projects';
---
<Base title="Rahul Negi — Backend, Payments & Distributed Systems Engineer" description="Senior software engineer building reliable backend systems, payment infrastructure, and web applications. Explore Rahul Negi’s projects and engineering experience.">
<section class="hero container">
  <div class="hero-copy"><p class="eyebrow"><span class="accent rule"></span> SOFTWARE ENGINEER · BUILDER · PROBLEM SOLVER</p><h1>Good systems<br/>hold up.<br/><span>Even when<br class="mobile-break"/> things don’t.</span></h1><p class="hero-description">{profile.description}</p><div class="hero-actions"><a href="/projects/" class="button primary">Explore my work <span aria-hidden="true">↗</span></a><a href="/about/" class="button quiet">A little about me <span aria-hidden="true">→</span></a></div></div>
  <div class="hero-system" role="img" aria-label="Illustrative architecture: a client request enters a Go service, reaches a database and event queue, and feeds an observable worker pipeline.">
    <div class="system-label"><span class="small-dot"></span> THINK IN SYSTEMS.</div><div class="system-stage"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><svg class="system-wires" viewBox="0 0 500 430" fill="none" aria-hidden="true"><path d="M250 70V145M250 223V265H111V306M250 265H389V306M111 346V383H389V346" stroke="#36545a"/><path class="wire-highlight" d="M250 70V145M250 223V265H111V306" stroke="#74dac7"/><circle cx="250" cy="265" r="4" fill="#74dac7"/><circle cx="111" cy="383" r="3" fill="#74dac7"/></svg><div class="system-client mono">↓ incoming.request</div><div class="system-core"><span class="core-symbol">{`{ }`}</span><div><strong>Built to hold up.</strong><span>Go · APIs · reliability</span></div><span class="core-light"></span></div><div class="system-db"><span>▤</span><strong>database</strong><small>consistent state</small></div><div class="system-queue"><span>≋</span><strong>event queue</strong><small>decoupled work</small></div><div class="system-bottom mono"><span class="small-dot"></span> observable at every step</div><span class="system-coordinate coord-left">01 / REQUEST</span><span class="system-coordinate coord-right">02 / RESILIENCE</span></div><div class="system-caption"><span>ARCHITECTURE IS A SERIES OF CHOICES.</span><span>MAKE THEM DELIBERATELY.</span></div>
  </div>
</section>
<div class="experience-strip container"><span class="eyebrow">ENGINEERING EXPERIENCE</span><span class="company-name razorpay">Razorpay</span><span class="company-name amazon">amazon<span>⌣</span></span><span class="strip-note">Payments. Platforms.<br/>Production realities.</span></div>
<section class="section container work-section" aria-labelledby="work-heading"><div class="section-heading"><div><p class="eyebrow accent">01 / SELECTED WORK</p><h2 id="work-heading">Less hand-waving.<br/>More working systems.</h2></div><div class="section-intro"><p>Independent projects. Real engineering decisions.<br/>The tradeoffs are part of the story.</p><a class="text-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a></div></div><div class="project-grid">{projects.map((project,index)=><ProjectCard project={project} index={index}/>)}</div></section>
<section class="section expertise-section" aria-labelledby="expertise-heading"><div class="container"><div class="section-heading"><div><p class="eyebrow accent">02 / HOW I BUILD</p><h2 id="expertise-heading">Across the stack.<br/>Deep in the details.</h2></div><p class="section-intro">Tools matter. Knowing where they fit<br/>matters more.</p></div><div class="expertise-grid">{expertise.map((e,index)=><div class="expertise-item"><span class="expertise-index mono">[ 0{index+1} ]</span><h3>{e.title}</h3><p>{e.text}</p><ul class="skill-list">{e.skills.map(skill=><li>{skill}</li>)}</ul></div>)}</div></div></section>
<section class="section container experience-section" aria-labelledby="experience-heading"><div><p class="eyebrow accent">03 / EXPERIENCE</p><h2 id="experience-heading">Shaped by<br/>production.</h2><p class="narrow muted">Experience with systems where correctness, compatibility, and a safe rollout matter.</p><a href="/about/" class="text-link">The longer story <span aria-hidden="true">↗</span></a></div><div class="experience-list">{experience.map(e=><article><div class="experience-title"><h3>{e.company}</h3><span class="mono">{e.period}</span></div><p class="role">{e.role}</p><p>{e.description}</p></article>)}</div></section>
<section class="section container services-section" aria-labelledby="services-heading"><div class="section-heading"><div><p class="eyebrow accent">04 / WAYS TO COLLABORATE</p><h2 id="services-heading">A clear problem.<br/>A considered solution.</h2></div><p class="section-intro">Focused engineering engagements,<br/>with a well-defined finish line.</p></div><div class="services-grid">{services.map(s=><article><span class="mono muted">{s.number} /</span><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></section>
<Contact/>
</Base>
