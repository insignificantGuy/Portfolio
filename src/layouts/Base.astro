---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import { profile } from '../data/profile';
interface Props { title: string; description: string; project?: { name: string; description: string }; noindex?: boolean; }
const { title, description, project, noindex = false } = Astro.props;
const indexable = (process.env.VERCEL_ENV === 'production' || process.env.INDEXABLE === 'true') && !noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const person = { '@type': 'Person', '@id': new URL('/#rahul', Astro.site).href, name: profile.name, url: Astro.site?.href, jobTitle: 'Senior Software Engineer', sameAs: [profile.github, profile.linkedin], knowsAbout: ['Go', 'Backend engineering', 'Distributed systems', 'Payment systems', 'React', 'Cloud infrastructure'] };
const graph: unknown[] = [person];
if (project) graph.push({ '@type': 'CreativeWork', name: project.name, description: project.description, url: canonical.href, author: { '@id': person['@id'] } });
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#101315"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:locale" content="en_US"/><meta property="og:site_name" content="Rahul Negi — Software Engineer"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/social.png', Astro.site)}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Rahul Negi — Reliable systems. Thoughtful engineering."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL('/images/social.png', Astro.site)}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<header class="site-header container"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">RN<span>.</span></span><span>RAHUL NEGI</span></a><nav aria-label="Main navigation"><a href="/projects/" aria-current={current.startsWith('/projects') ? 'page' : undefined}>Work</a><a href="/about/" aria-current={current === '/about/' ? 'page' : undefined}>About</a><a class="nav-contact" href="/#contact">Let’s talk <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><slot/></main>
<footer class="site-footer container"><a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true">RN<span>.</span></span><span>Thoughtful code. Dependable systems.</span></a><div class="footer-links"><a href={profile.github}>GitHub ↗</a><a href={profile.linkedin}>LinkedIn ↗</a><a href="/resume.pdf" download="Rahul-Negi-Resume.pdf">Resume ↓</a></div><p>© {new Date().getFullYear()} Rahul Negi</p></footer>
</body></html>
